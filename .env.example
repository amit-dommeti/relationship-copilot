# No secrets are needed for local use. Never commit a filled-in .env file.
PORT=4173
# Required when NODE_ENV=production (Docker / Render).
APP_ORIGIN=http://localhost:4173
APP_PASSWORD=
SESSION_SECRET=
DATA_DIR=./data
# Optional AI. Only the selected person's context is sent when Draft is clicked.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# US accounts use LinkedIn's official archive. No LinkedIn password or token is stored.
